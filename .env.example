# gitops-oncall-mcp — configuration
# Copy to .env and fill in.
#
#   [REQUIRED]   the server refuses to start without it
#   [OPTIONAL]   has a default, change only if your setup differs


# ── Observability query APIs ─────────────────────────────────────────
#
# Addressed directly, not through a Grafana datasource proxy. In a cluster
# these are Services, so the values below are usually in-cluster DNS names
# and no credential is involved.
#
# To develop against a real cluster from a laptop, port-forward each one and
# point these at localhost.

# [REQUIRED] Prometheus HTTP API.
PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.monitoring.svc:9090

# [REQUIRED] Loki HTTP API.
LOKI_URL=http://loki.monitoring.svc:3100

# [OPTIONAL] Alertmanager HTTP API. Leave unset if you do not run one:
# get_active_alerts then reads the same alerts from Prometheus instead, and
# labels them as such. Alertmanager is worth configuring because only it knows
# what a human has silenced, and a silenced alert is not an incident.
# ALERTMANAGER_URL=http://kube-prometheus-stack-alertmanager.monitoring.svc:9093

# [OPTIONAL] Bearer token sent to all three. Only needed when they sit behind
# an auth proxy. In-cluster access needs nothing.
# OBSERVABILITY_TOKEN=

# [OPTIONAL] Path to a CA bundle, for self-signed TLS in front of the above.
# OBSERVABILITY_CA_CERT_PATH=/etc/gitops-oncall-mcp/ca.pem


# ── Label conventions ────────────────────────────────────────────────
#
# How your own services are labelled in Prometheus and Loki. The queries are
# built from these, so they decide whether anything matches at all.

# [OPTIONAL] Label key identifying the environment. Default: env
# Many clusters separate environments by namespace rather than by an `env`
# label, in which case set this to `namespace` and map the names below.
ENV_LABEL_KEY=env

# [OPTIONAL] Map the environment names the agent uses onto the label values
# your metrics actually carry, as name:value pairs. Unset means the name is
# used verbatim. Check yours first — a name that matches nothing returns an
# empty result, which is indistinguishable from a healthy zero:
#   curl -s localhost:9090/api/v1/label/<ENV_LABEL_KEY>/values
# ENV_VALUE_MAP=production:procal,staging:procal-staging

# [OPTIONAL] Label key identifying the team. Default: team
TEAM_LABEL_KEY=team

# [OPTIONAL] Team label value. Leave empty to skip team filtering entirely.
TEAM_LABEL_VALUE=


# ── Kubernetes ───────────────────────────────────────────────────────
#
# Credentials come from the ambient kubeconfig or, in-cluster, the pod's
# service account. Nothing is configured here but the namespace.

# [REQUIRED] The one namespace the Kubernetes tools may read. Fixed here and
# deliberately not a tool argument: the model chooses what to ask about,
# never what it has access to.
K8S_NAMESPACE=

# [OPTIONAL] Namespace Argo CD runs in, read by the Application tool.
ARGOCD_NAMESPACE=argocd


# ── GitHub ───────────────────────────────────────────────────────────
#
# Use a fine-grained PAT scoped to the repositories below and nothing else.
# Permissions:
#   Contents       read, plus write only if you use the pull-request tool
#   Pull requests  read, plus write only if you use the pull-request tool
#   Actions        read, plus write only if you dispatch a workflow

# [REQUIRED]
GITHUB_TOKEN=

# [REQUIRED] Owner, e.g. an org or your username.
GITHUB_OWNER=

# [REQUIRED] Repository holding the deployment config Argo CD reads. This is
# also where pull requests are opened.
GITHUB_REPO=

# [OPTIONAL] Comma-separated application repositories, which is where release
# tags live. The config repo carries no tags, so get_recent_deploys returns
# nothing until these are set.
# GITHUB_APP_REPOS=dora,boots,maps

# [OPTIONAL] Path to each environment's values file inside the config repo,
# with {env} substituted. A rollback changes the `tag:` under that service in
# this file, so the layout it assumes is: a per-service block with a `tag` key.
GITHUB_VALUES_PATH=envs/{env}/values.yaml

# [OPTIONAL] Workflow with `on: workflow_dispatch` that takes a `ref` input.
# Only used by the deploy-dispatch tool.
GITHUB_DEPLOY_WORKFLOW=deploy.yml

# [OPTIONAL] GitHub Enterprise API base. The default suits github.com.
GITHUB_API_BASE=https://api.github.com


# ── Release tag conventions ──────────────────────────────────────────
#
# How your repository tags releases per environment. Defaults match
# v0.0.1 for prod, v0.0.1-stag for staging, v0.0.1-dev for dev.

# [OPTIONAL] Regex matching production tags.
DEPLOY_TAG_PROD_REGEX=^v\d+\.\d+\.\d+$

# [OPTIONAL] Suffix for dev tags.
DEPLOY_TAG_NONPROD_SUFFIX_DEV=-dev

# [OPTIONAL] Suffix for staging tags.
DEPLOY_TAG_NONPROD_SUFFIX_STAGING=-stag


# ── Server ───────────────────────────────────────────────────────────

# [OPTIONAL] Bind address. The default is loopback only.
# Set 0.0.0.0 only together with MCP_BEARER_TOKEN.
MCP_HOST=127.0.0.1

# [OPTIONAL] Port.
MCP_PORT=8765

# [OPTIONAL, REQUIRED if you bind beyond loopback]
# Every request must then carry: Authorization: Bearer <this value>
# Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=


# ── Guardrails ───────────────────────────────────────────────────────
#
# Anything that changes the world is split into propose_* which has no effect
# and returns a proposal id, and confirm_* which acts and demands that id.
# Two deliberate tool calls, so a single confused turn cannot deploy.

# [OPTIONAL] How long a proposal id stays valid. The default gives a human
# time to read it and reply. Shorten it for autonomous callers.
PROPOSAL_TTL_SECONDS=600

# [OPTIONAL] Append-only audit log. Unset means stderr only, which is still
# captured by the container runtime.
# AUDIT_LOG_PATH=/var/log/gitops-oncall-mcp/audit.jsonl
